# Copy to .env.local and point at your backend.
# Vite inlines VITE_ vars into the build at build time — never put secrets
# here, only the public API URL.

# Local dev (backend running on your machine):
VITE_API_URL=http://localhost:4000

# Production: your deployed backend URL, e.g.
# VITE_API_URL=https://roti-api.onrender.com
