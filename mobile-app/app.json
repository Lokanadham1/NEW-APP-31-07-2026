{
  "expo": {
    "name": "Poli Parampara",
    "slug": "roti-and-more",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "scheme": "poliparampara",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FFFBF2"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "android": {
      "package": "com.poliparampara.myapp",
      "versionCode": 1,
      "googleServicesFile": "./google-services.json",
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FFFBF2"
      },
      "permissions": []
    },
    "ios": {
      "bundleIdentifier": "com.poliparampara.myapp",
      "supportsTablet": false
    },
    "plugins": [
      "@react-native-firebase/app",
      [
        "expo-notifications",
        {
          "color": "#1B7A3C"
        }
      ],
      "expo-font",
      "expo-secure-store",
      "expo-status-bar"
    ],
    "extra": {
      "eas": {
        "projectId": "f5393e2c-41f7-429d-8495-04d1bb5939a9"
      }
    }
  }
}