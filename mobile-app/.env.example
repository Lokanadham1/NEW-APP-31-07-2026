# Copy to .env and point at your backend.
# EXPO_PUBLIC_ vars are inlined into the app bundle at build/start time —
# never put secrets here, only the public API URL.

# Local dev on an Android emulator (10.0.2.2 = your computer's localhost):
EXPO_PUBLIC_API_URL=http://10.0.2.2:4000

# Local dev on a physical phone via Expo Go: use your computer's LAN IP instead, e.g.
# EXPO_PUBLIC_API_URL=http://192.168.1.50:4000

# Production: your deployed backend URL, e.g.
# EXPO_PUBLIC_API_URL=https://roti-api.onrender.com
