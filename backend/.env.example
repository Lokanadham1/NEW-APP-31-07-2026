# Copy to .env and adjust.

PORT=4000

# Production: lock the API to your frontend origin(s), comma-separated.
# Leave empty in dev to allow all origins.
CORS_ORIGIN=

# Path to the SQLite file. On hosts with an attached disk, point this at the
# mounted volume so data survives redeploys, e.g. /data/roti.db
DB_PATH=

# Secret used to sign JWTs. Use a long random string in production.
JWT_SECRET=change-this-to-a-long-random-secret

# Comma-separated list of admin mobile numbers (10-digit, no +91).
# Any number in this list is issued role=admin at login. NEVER ship this to the client.
ADMIN_MOBILES=7730001663

# OTP delivery. Leave OTP_PROVIDER empty for DEV mode:
#   in dev the generated code is logged to the server console AND returned in the
#   /auth/request-otp response as devCode so you can test without paying for SMS.
# Set to "firebase" | "msg91" | "twilio" and fill the matching keys to go live.
OTP_PROVIDER=
OTP_TTL_SECONDS=300

# MSG91 (India) — used only when OTP_PROVIDER=msg91
MSG91_AUTHKEY=
MSG91_TEMPLATE_ID=

# firebase: OTP handled on the client SDK; backend verifies the ID token.
# Set OTP_PROVIDER=firebase and point this at your service-account JSON.
FIREBASE_SERVICE_ACCOUNT=/absolute/path/to/serviceAccountKey.json

# Twilio Verify — used only when OTP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_VERIFY_SERVICE_SID=
